pids
*.pid
*.seed

# environment file
.env

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directory
# https://docs.npmjs.com/misc/faq#should-i-check-my-node-modules-folder-into-git
node_modules

# Root-level scaffolding sketches only (CYCLE-CONTACTS-2.md and friends) —
# the plain-English co-design files Andy deletes once the thinking has moved.
# Anchored and extension-bound on purpose: as a bare `CYCLE*` this also
# swallowed design/cycles/ and spirit/test/cycleRequirements.js (core.ignorecase
# is true here), so the one mechanism built to stop an agreement being lost was
# itself unsaveable, and silently — an ignored path shows in `git status` as
# nothing at all.
/CYCLE-*.md
sandbox
published
release
preferences.json
# testicle's verb preferences is declared by this file beside its server (goal/G47.1, box v79, 4); the preferences
# themselves stay in its state folder, ignored.
!spirit/run/spirit/app/testicle/preferences.json
conversation.json
history.json
log.jsonl
spirit/currentIssues.md

# Desk's record as Desk once kept it in its own folder (desk/G1.O10, Andy:
# "yes"). From desk/G1.4 the desk server imports these into desk.db, in
# relay-state/process/desk/, and removes them; tracked, every checkout that
# pulled would import Andy's record into its own desk.db, and every planted
# test node would boot with it. D5: "any appServer state is none of git's
# business". Past commits still hold them.
spirit/run/spirit/app/desk/element/desk/log/
spirit/run/spirit/app/desk/element/desk/voice/
spirit/run/spirit/app/desk/element/desk/state.json
spirit/run/spirit/app/desk/element/desk/seen.json

# Personal media that ended up in a folder named test/pix rather than real
# test fixtures — unreferenced by any code or test (verified), 20MB.
spirit/test/pix

# Per-process relay state: routingTable.json, allow.json, and identity.json —
# the last of which holds an Ed25519 PRIVATE KEY. relayAuth.js's header has
# always said these "live on that process's spirit/run home, never in git",
# but until now nothing enforced it. This is not hypothetical once a relay
# runs on a public host and actually has an identity: a single `git add -A`
# would stage the key, and because both setupRelayFakes.js and labMaster's
# copyTrackedSpirit build node homes from `git ls-files`, a committed key
# would then be sprayed into every fake node in the lab.
# Unanchored on purpose — matches spirit/run/relay-state/ and any other
# node home's copy, wherever it ends up.
relay-state/
# The companion of relay-state and its future replacement (goal/G43's box: "repo://spirit/run/spirit/state/", ".gitignored").
spirit/run/spirit/state/

# Relay Chat's remembered binding (chat 1): which public label this node
# claimed, so a reload does not ask again. Per-node session state, like
# relay-state above and preferences.json — never product code, and
# meaningless in another clone. It also must not reach the lab:
# setupRelayFakes.js builds fake nodes from `git ls-files`, so a
# committed session.json would hand every fake node Andy's label.
# Unanchored, to match the file wherever an app folder ends up.
session.json

loop.json
configuration.json

# Relay Chat's remembered view (chat 6): who was selected, which filter,
# and how far each conversation had been read. Same class as
# session.json above — this node's state about itself, never product
# code, and it names peer keys, so it must not reach the lab either.
view.json

# Relay Chat's settings (chat settings cycle): what this node has decided
# about mail from people it has not added, and the labels it has minted
# invites for. Same class as session.json and view.json above — this
# node's own state, meaningless in another clone, and it must not reach
# the lab either, since setupRelayFakes.js builds fake nodes from
# `git ls-files`.
prefs.json

# Scratch a person made while trying the Text Editor out. Not product
# code and not this node's state either — just a file somebody typed in
# to see whether saving worked. Unanchored, like the names above,
# because the next one will be made wherever the editor was pointed.
notes.txt

# The labels this node has minted invites for (natterRememberMinted).
# Same class as session.json, view.json and prefs.json above: this node's
# own state, meaningless in another clone. It also names people — a label
# is what somebody will be called on a mailbox once they claim — and it
# must not reach the lab, since setupRelayFakes.js builds fake nodes from
# `git ls-files`.
#
# The token is deliberately NOT in it: that is the secret, spoken down a
# phone and never written here. This is the half that lets an owner
# recognise the key when it turns up on their census.
minted.json

# Anything js/peerFile.js names: one file per peer, wherever an app
# keeps them. Chat logs are the first (app/relayChat/logs/, also caught
# by the bare `logs` rule above); whatever comes next is the reason this
# is a pattern rather than a path.
# (It also named whoBook sidecars: historical, whoBook was renamed
# contacts.js on 2026-09-18 and keeps one file, contacts.json.)
#
# Data belonging to a peer is personal by definition — the mailbox keeps
# messages by recipient and grows no sender copy, so the record of a
# conversation lives on the node that took part in it. It must not reach
# the lab either: setupRelayFakes.js builds fake nodes from
# `git ls-files`.
#
# The prefix is what makes one line enough, and it is why session.json
# is listed separately above: that is one file about this node, not a
# file about a peer.
**/peerfile-*.json

# Desk's own log (AGENTS-UI.md): Andy's conversation with the agents, kept
# by the app in its own folder because "they must keep their own logs".
# His words, never pushed.

NEXT_PROMPT.md

# ── A RESTARTED NODE'S CONSOLE, WHEREVER IT IS RESTARTED FROM ────────
#
# Starting a node detached needs somewhere for its stdout and stderr to
# go, and the obvious place is beside the clone it runs from. Those two
# files are the node's console and nothing else — they are recreated on
# every start and mean nothing to anybody who was not watching that
# process. Added 2026-09-24 after rule 11b's first application left them
# in `git status` in two checkouts.
#
# It matters more here than the size of the files suggests: this
# repository stages by name and never `git add -A`, and untracked noise
# in the root is exactly what makes somebody reach for the shortcut.
node.out
node.err

# Per-app state (G12): code is replaced by deployment, state is not.
# Same reason relay-state is ignored above.
app-state/

# What one box says about itself (see .spiritbox.example). Machine facts,
# never shared: the file exists so a box can stop re-typing them.
.spiritbox

# RUN:// IS SPIRIT'S ONE NAME (goal/G43.32). Andy: "this move will free the run:// folder namespace and SpiritOS will
# only take up 1 name ("spirit") in it. .gitignore will be updated to ignore the run:/ folder except for run://spirit/".
# Everything else under spirit/run/ is the node's or the person's (uploads, published files, a node's console, Andy's
# vault), so no line above names a path there.
/spirit/run/*
!/spirit/run/spirit/

# THE LAB (goal/G47.3, the box: "repo://lab/node/ is .gitignored"; "lab has its own local repo, inside a .gitignored
# repo://lab/<name>/"): lab's own repo, lab/repo/, and its nodes and relays, lab/node/, made on this machine by
# lab/labNodes.js and never shared. Their lock and pid files live there too.
/lab/node/
/lab/repo/

# TESTICLE'S PLANTED WORLDS (goal/G47.1, box v143: "no spirit/zzTesticle/ or other zz folder in the tree: the planted scripts
# go to a .gitignored run://spirit/app/testicle/temp/"): what testicle's own test plants on its scratch node.
/spirit/run/spirit/app/testicle/temp/
