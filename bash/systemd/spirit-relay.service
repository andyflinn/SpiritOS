[Unit]
Description=SpiritOS public relay
After=network.target
Documentation=https://github.com/andyflinn/SpiritOS

[Service]
Type=simple
# One-operator host. root is spirit. No second Unix user.
WorkingDirectory=__RUN_DIR__
ExecStart=/usr/bin/node js/server.js --relay --port __PORT__
Restart=on-failure
RestartSec=3
Environment=PORT=__PORT__

# Soft sandbox. The process still runs as root because this box has
# one operator and the clone lives under /root. These flags limit what
# a bug in the request path can touch without inventing a second identity.
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
