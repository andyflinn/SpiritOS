#!/bin/bash
# Refresh product code from origin/master. Never touches relay-state/.
#
#   ./bash/update           fetch; restart only if the commit moved
#   ./bash/update --force   restart whatever the commit says
#
# ── WHY --force EXISTS ───────────────────────────────────────────────
#
# "Already at origin/master" answers a question about the REPOSITORY, and
# the thing being managed is a PROCESS. The two came apart within an hour
# of the cron first working: /root/SpiritOS took c8b7293 and went on
# running the previous binary, because the restart went to the wrong unit
# and the next run then said "already at c8b7293 — no restart" and left
# it there. The early exit is correct for a scheduled poll and wrong for
# somebody asking for a restart on purpose.
source "$(dirname "$0")/lib.sh"
need_root
[ -d "$REPO_ROOT/.git" ] || die "not a git clone: $REPO_ROOT"

FORCE=no
[ "${1:-}" = "--force" ] && FORCE=yes

cd "$REPO_ROOT"
say "fetch origin ($TRACK)"
# --tags, because the tag-tracking clone cannot see a release it has not
# fetched, and a plain fetch does not reliably bring tags on every git.
git fetch --tags origin

# ── WHERE THIS CLONE IS ALLOWED TO GO ────────────────────────────────
#
# See TRACK in lib.sh. The live relay follows tags because it is the
# clone with no .env; the lab says `master` in its own.
case "$TRACK" in
  master)
    TARGET="origin/master"
    WHAT="origin/master"
    ;;
  tag)
    # ── ONLY `v*` COUNTS AS A RELEASE ────────────────────────────────
    #
    # This matched ANY tag for about an hour, and that was very nearly a
    # disaster. The repository already carried four tags, and none of
    # them is a release — they are milestone and archive markers:
    #
    #   APP_SPECIFIC_RELAY_PROTOCOL  2026-09-08   <- newest
    #   mailbox-keys-2026-09-07
    #   END_OF_SKELLETON_PHASE
    #   archive/zs4-2016-2026
    #
    # `git describe --abbrev=0 origin/master` picked the first of those:
    # commit 2bf5d6c, 194 commits and eight days behind master. The live
    # public relay would have reset --hard BACKWARDS onto it and
    # restarted, unattended, at a ten-minute tick. Caught by looking at
    # the tag list before the second tick, not by any check here.
    #
    # So a release tag is `v*` and nothing else. A marker someone dropped
    # to remember a phase by is not a thing to deploy.
    TAG=$(git describe --tags --abbrev=0 --match 'v*' origin/master 2>/dev/null || true)
    if [ -z "$TAG" ]; then
      # NOT A FALLBACK TO master. A clone that tracks tags and finds
      # none stays exactly where it is: falling back would hand back the
      # whole gate at the first moment it means anything, which is
      # before the first tag exists.
      warn "no tag on origin/master — staying at $(git rev-parse --short HEAD)"
      echo "    this clone tracks tags (SPIRIT_TRACK=$TRACK). Cut one to release:"
      echo "      git tag -a v0.1.0 -m 'first release' && git push origin v0.1.0"
      exit 0
    fi
    TARGET="$TAG"
    WHAT="tag $TAG"
    ;;
  *)
    die "SPIRIT_TRACK is '$TRACK' — want 'tag' or 'master'"
    ;;
esac

LOCAL=$(git rev-parse HEAD)
REMOTE=$(git rev-parse "$TARGET^{commit}")

# ── AN UPDATE NEVER GOES BACKWARDS ───────────────────────────────────
#
# Belt to the `v*` brace above, because the failure it guards is the
# worst one available here: a relay silently serving eight-day-old code
# after a routine tick, with `dirty:false` and a plausible commit id, so
# nothing downstream looks wrong.
#
# Any way of choosing a target can choose an older one — a tag moved, a
# tag deleted, a release branch rewound, or simply a marker that sorts
# newest. Whatever the cause, "update" cannot mean "go back": a rollback
# is a deliberate act with somebody watching, not something a cron does
# at :20. So if the target is an ancestor of where we already are, stay
# put and say so loudly.
if [ "$LOCAL" != "$REMOTE" ] && git merge-base --is-ancestor "$REMOTE" "$LOCAL"; then
  warn "REFUSING TO GO BACKWARDS — $WHAT is behind this clone"
  echo "    here:   $(git rev-parse --short "$LOCAL")  $(git log -1 --format=%cI "$LOCAL")"
  echo "    target: $(git rev-parse --short "$REMOTE")  $(git log -1 --format=%cI "$REMOTE")"
  echo "    $(git rev-list --count "$REMOTE..$LOCAL") commit(s) would be undone. Nothing changed."
  echo "    To roll back on purpose, do it by hand with somebody watching."
  exit 0
fi

if [ "$LOCAL" = "$REMOTE" ] && [ "$FORCE" = no ]; then
  ok "already at $(git rev-parse --short HEAD) ($WHAT) — no restart"
  exit 0
fi

if [ "$LOCAL" = "$REMOTE" ]; then
  say "already at $(git rev-parse --short HEAD) — restarting anyway (--force)"
fi

say "reset --hard $WHAT"
echo "    $(git rev-parse --short HEAD) -> $(git rev-parse --short "$REMOTE")"
git reset --hard "$REMOTE"

# ── THE CONFIG WE LOADED IS NOW OLD CODE ─────────────────────────────
#
# lib.sh was sourced at line 3, and line 21 just replaced it. Everything
# below decides things — WHICH UNIT TO RESTART, above all — and until
# this re-read it decided them from the copy that was on disk before the
# update. A change to how a clone works therefore took effect one cycle
# LATE: the run that installed it still behaved the old way.
#
# Seen on spirit-3, 2026-09-16, the run that shipped the fix for exactly
# this class of thing:
#
#   cd /root/SpiritOS && ./bash/update
#   ==> reset --hard origin/master
#       af596bf -> c8b7293          <- new lib.sh, which ignores the shell
#   ==> restart spirit-lab          <- old lib.sh, which did not
#
# The live relay took the new code and never restarted; the LAB's service
# got bounced by the main clone instead. Re-reading costs nothing and the
# file is idempotent — no readonly, no side effects, just assignments.
#
# This does NOT re-exec. A second run would fetch, find HEAD already at
# origin/master, and exit "no restart" — the restart would be lost
# entirely. The configuration is what has to be current here.
# shellcheck source=lib.sh
source "$REPO_ROOT/bash/lib.sh"

# No pipe: see `unit_known` in lib.sh. This line reported "not
# installed" on a box where the unit was installed, enabled and active,
# so an update never restarted anything.
if unit_known "$UNIT_NAME"; then
  say "restart $UNIT_NAME"
  systemctl restart "$UNIT_NAME"
  # An update that lands code the relay refuses to run on (exit 78) must
  # say so, not "restarted". See check_started in lib.sh.
  check_started "$UNIT_NAME"
else
  warn "unit $UNIT_NAME not installed — code updated, process not restarted"
fi
