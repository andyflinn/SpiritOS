#!/bin/bash
# Show whether the public relay is actually the thing we think it is.
source "$(dirname "$0")/lib.sh"

echo "repo:    $REPO_ROOT"
echo "run dir: $RUN_DIR"
echo "domain:  $DOMAIN"
echo "node:    127.0.0.1:$NODE_PORT (--relay)"
echo "role:    PUBLIC RELAY — labMaster does not run here"
echo

if [ -d "$REPO_ROOT/.git" ]; then
  say "git"
  echo "    HEAD   $(git -C "$REPO_ROOT" rev-parse --short HEAD 2>/dev/null || echo '?')"
  echo "    branch $(git -C "$REPO_ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"
  git -C "$REPO_ROOT" fetch origin --quiet 2>/dev/null || warn "git fetch failed (offline?)"
  LOCAL=$(git -C "$REPO_ROOT" rev-parse HEAD 2>/dev/null || echo none)
  REMOTE=$(git -C "$REPO_ROOT" rev-parse origin/master 2>/dev/null || echo none)
  if [ "$LOCAL" = "$REMOTE" ]; then
    ok "matches origin/master"
  else
    warn "HEAD != origin/master  (run ./bash/update)"
  fi
else
  warn "not a git clone"
fi

echo
say "systemd $UNIT_NAME"
if have systemctl; then
  systemctl is-enabled "$UNIT_NAME" 2>/dev/null && ok "enabled at boot" || warn "not enabled at boot"
  systemctl is-active "$UNIT_NAME" 2>/dev/null && ok "active" || warn "not active"

  # This process answers the open internet and needs no privilege at all.
  # An old unit predating the hardening still says root — shout, the same
  # way this script shouts about labMaster.
  RUN_AS=$(systemctl show -p User --value "$UNIT_NAME" 2>/dev/null)
  if [ -z "$RUN_AS" ] || [ "$RUN_AS" = "root" ]; then
    warn "RUNS AS ROOT — reinstall the unit: ./bash/install-units"
  else
    ok "runs as $RUN_AS (unprivileged)"
  fi
else
  warn "no systemctl on this machine"
fi

echo
say "listeners"
if have ss; then
  ss -tlnp | grep -E ":($NODE_PORT|80|443)\\b" || warn "nothing on $NODE_PORT / 80 / 443"
else
  warn "ss not installed"
fi

echo
say "labMaster must NOT be here (port 65420)"
if have ss && ss -tln | grep -q ':65420 '; then
  warn "PORT 65420 IS LISTENING — that is labMaster. Stop it. This box is a mailbox."
else
  ok "65420 is quiet"
fi

echo
say "mailbox who (https://$DOMAIN)"
if have curl; then
  if curl -fsS --max-time 8 "https://$DOMAIN/api/relay/who" ; then
    echo
    ok "https who answered"
  else
    warn "https who failed (tls not up, or DNS, or node down)"
  fi
  if curl -fsS --max-time 5 "http://127.0.0.1:$NODE_PORT/api/relay/who" >/dev/null; then
    ok "local node :$NODE_PORT who answered"
  else
    warn "local node :$NODE_PORT not answering"
  fi
else
  warn "curl not installed"
fi
