#!/bin/bash
# Show whether the public relay is actually the thing we think it is.
# One-operator policy: root is spirit. Running as root is success.
source "$(dirname "$0")/lib.sh"

echo "repo:    $REPO_ROOT"
echo "run dir: $RUN_DIR"
echo "domain:  $DOMAIN"
echo "node:    127.0.0.1:$NODE_PORT (--relay)"
echo "role:    PUBLIC RELAY — labMaster does not run here"
echo "policy:  one operator — root is spirit"
echo

if [ -d "$REPO_ROOT/.git" ]; then
  say "git (tracks: $TRACK)"
  echo "    HEAD   $(git -C "$REPO_ROOT" rev-parse --short HEAD 2>/dev/null || echo '?')"
  echo "    branch $(git -C "$REPO_ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"
  git -C "$REPO_ROOT" fetch --tags origin --quiet 2>/dev/null || warn "git fetch failed (offline?)"
  LOCAL=$(git -C "$REPO_ROOT" rev-parse HEAD 2>/dev/null || echo none)
  # ASK THE SAME QUESTION bash/update ASKS. This compared against
  # origin/master whatever the clone followed, so the moment the live
  # relay started tracking tags it would have reported "HEAD !=
  # origin/master (run ./bash/update)" for ever — telling the operator
  # to fix a relay that is correctly sitting on its release.
  if [ "$TRACK" = "master" ]; then
    WANT=$(git -C "$REPO_ROOT" rev-parse origin/master 2>/dev/null || echo none)
    WHAT="origin/master"
  else
    TAG=$(git -C "$REPO_ROOT" describe --tags --abbrev=0 --match 'v*' origin/master 2>/dev/null || true)
    if [ -z "$TAG" ]; then
      WANT="$LOCAL"
      WHAT="no tag yet — pinned here until one is cut"
    else
      WANT=$(git -C "$REPO_ROOT" rev-parse "$TAG^{commit}" 2>/dev/null || echo none)
      WHAT="tag $TAG"
    fi
  fi
  echo "    wants  $WHAT"
  if [ "$LOCAL" = "$WANT" ]; then
    ok "matches $WHAT"
  else
    warn "HEAD != $WHAT  (run ./bash/update)"
  fi
else
  warn "not a git clone"
fi

echo
say "systemd $UNIT_NAME"
if have systemctl; then
  systemctl is-enabled "$UNIT_NAME" 2>/dev/null && ok "enabled at boot" || warn "not enabled at boot"
  systemctl is-active "$UNIT_NAME" 2>/dev/null && ok "active" || warn "not active"
  UNIT_USER=$(systemctl show "$UNIT_NAME" -p User --value 2>/dev/null || true)
  if [ -z "$UNIT_USER" ] || [ "$UNIT_USER" = "root" ]; then
    ok "runs as root (one operator)"
  else
    warn "runs as $UNIT_USER — one-operator policy expects root"
  fi
else
  warn "no systemctl on this machine"
fi

echo
say "listeners"
if have ss; then
  ss -tlnp | grep -E ":($NODE_PORT|80|443)\\b" || warn "nothing on $NODE_PORT / 80 / 443"
else
  warn "ss not installed"
fi

echo
say "labMaster must NOT be here (port 65420)"
if have ss && contains "$(ss -tln)" ':65420 '; then
  warn "PORT 65420 IS LISTENING — that is labMaster. Stop it. This box is a relay."
else
  ok "65420 is quiet"
fi

echo
say "relay who (https://$DOMAIN)"
if have curl; then
  if curl -fsS --max-time 8 "https://$DOMAIN/api/relay/who" ; then
    echo
    ok "https who answered"
  else
    warn "https who failed (tls not up, or DNS, or node down)"
  fi
  if curl -fsS --max-time 5 "http://127.0.0.1:$NODE_PORT/api/relay/who" >/dev/null; then
    ok "local node :$NODE_PORT who answered"
  else
    warn "local node :$NODE_PORT not answering"
  fi
else
  warn "curl not installed"
fi
