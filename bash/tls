#!/bin/bash
# Caddy terminates HTTPS for $DOMAIN and proxies to local Node.
source "$(dirname "$0")/lib.sh"
need_root

if ! have caddy; then
  say "install caddy"
  if have apt-get; then
    apt-get update -y
    apt-get install -y debian-keyring debian-archive-keyring apt-transport-https curl
    curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/gpg.key' \
      | gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg
    curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt' \
      | tee /etc/apt/sources.list.d/caddy-stable.list >/dev/null
    apt-get update -y
    apt-get install -y caddy
  else
    die "install caddy yourself, then rerun ./bash/tls"
  fi
fi

say "write /etc/caddy/Caddyfile for $DOMAIN -> 127.0.0.1:$NODE_PORT"
sed "s/__DOMAIN__/$DOMAIN/g; s/__PORT__/$NODE_PORT/g" \
  "$REPO_ROOT/bash/caddy/Caddyfile" > /etc/caddy/Caddyfile

systemctl enable caddy
systemctl reload caddy || systemctl restart caddy
ok "caddy serving $DOMAIN"
echo "    DNS A $DOMAIN must point at this box or the certificate will fail."
echo "    check: ./bash/status"
